@page "/"
@inject IWorkspaceService Workspace

<PageTitle>LifeOS — osobisty system zarządzania</PageTitle>

<HeadContent>
    <meta property="og:title" content="LifeOS — osobisty system zarządzania" />
    <meta property="og:description" content="Zadania, notatki, rutyny i obszary życia w jednym biznesowym panelu." />
</HeadContent>

<div class="@ShellClass">
    @if (_mobileMenuOpen)
    {
        <button class="menu-overlay" type="button" aria-label="Zamknij menu" @onclick="CloseMobileMenu"></button>
    }

    <aside class="@SidebarClass">
        <div class="sidebar-header">
            <button class="brand" type="button" title="LifeOS" @onclick='() => SetView("Dzisiaj")'>
                <span><i></i><i></i><i></i><i></i></span>
                <div><strong>LifeOS</strong><small>Twój dzień, po Twojemu</small></div>
            </button>
            <button class="sidebar-collapse" type="button" aria-label="@(_menuCollapsed ? "Rozwiń menu" : "Zwiń menu")" title="@(_menuCollapsed ? "Rozwiń menu" : "Zwiń menu")" @onclick="ToggleMenu">@(_menuCollapsed ? "›" : "‹")</button>
            <button class="mobile-menu-close" type="button" aria-label="Zamknij menu" @onclick="CloseMobileMenu">×</button>
        </div>

        <div class="quick-create">
            <button class="quick-create-trigger" type="button" aria-expanded="@_quickMenuOpen" @onclick="ToggleQuickMenu">
                <span>+</span><strong>Dodaj coś</strong><kbd>N</kbd>
            </button>
            @if (_quickMenuOpen)
            {
                <div class="quick-create-menu">
                    <button type="button" @onclick='() => OpenComposer("Zadania")'><span>@Icon("tasks")</span><div><strong>Nowe zadanie</strong><small>Trafi do planu i kalendarza</small></div></button>
                    <button type="button" @onclick='() => OpenComposer("Notatki")'><span>@Icon("notes")</span><div><strong>Nowa notatka</strong><small>Zapisz pomysł lub decyzję</small></div></button>
                    <button type="button" @onclick='() => SetView("Przypomnienia")'><span>@Icon("bell")</span><div><strong>Przypomnienie</strong><small>Nie pozwól sprawie zniknąć</small></div></button>
                </div>
            }
        </div>

        <nav class="side-nav" aria-label="Główne sekcje">
            @foreach (var group in NavigationGroups)
            {
                <section class="nav-group">
                    <small>@group.Name</small>
                    @foreach (var item in group.Items)
                    {
                        <button type="button" class="@NavClass(item.Name)" title="@item.Name" @onclick="() => SetView(item.Name)">
                            <span class="nav-icon">@Icon(item.Icon)</span>
                            <em>@item.Name</em>
                            @if (item.Name == "Zadania" && Dashboard is not null)
                            {
                                <b>@Dashboard.OpenTasks</b>
                            }
                            else if (item.Name == "Przypomnienia" && Dashboard is not null)
                            {
                                <b class="alert-badge">@ReminderCount</b>
                            }
                        </button>
                    }
                </section>
            }
        </nav>

        <div class="sidebar-sync"><span><i></i>Wszystko zapisane</span><small>Twoje dane są bezpieczne</small></div>
        <div class="user-card"><span>RL</span><div><strong>Radek</strong><small>Profil prywatny</small></div><button type="button" aria-label="Ustawienia" title="Ustawienia">•••</button></div>
    </aside>

    <section class="workspace">
        <header class="topbar">
            <button class="mobile-menu-trigger" type="button" aria-label="Otwórz menu" @onclick="OpenMobileMenu"><span></span><span></span><span></span></button>
            <label class="search-box">
                <span>⌕</span>
                <input value="@_search" @oninput="SearchChanged" placeholder="Znajdź zadanie, notatkę lub projekt…" />
                <kbd>Ctrl K</kbd>
            </label>
            <div class="top-actions">
                <span>@PolishDate</span>
                <button class="icon-button notification-button" type="button" aria-label="Powiadomienia" @onclick='() => SetView("Przypomnienia")'>@Icon("bell")<b>@ReminderCount</b></button>
                <button class="primary-button" type="button" @onclick='() => OpenComposer("Zadania")'>+ Dodaj</button>
            </div>
        </header>

        <main class="content">
            @if (Dashboard is null)
            {
                <div class="loading-state"><i></i><strong>Przygotowuję Twój pulpit…</strong></div>
            }
            else if (!string.IsNullOrWhiteSpace(_search))
            {
                <header class="page-heading"><div><span>WYSZUKIWANIE</span><h1>Wyniki dla „@_search”</h1><p>Zadania i notatki pasujące do zapytania.</p></div><button class="secondary-button" type="button" @onclick="ClearSearch">Wyczyść</button></header>
                <section class="search-results">
                    @foreach (var result in SearchResults)
                    {
                        <article><span>@result.Type</span><strong>@result.Content</strong></article>
                    }
                    @if (SearchResults.Count == 0)
                    {
                        <div class="empty-state"><strong>Brak wyników</strong><p>Spróbuj krótszego hasła.</p></div>
                    }
                </section>
            }
            else
            {
                <header class="page-heading">
                    <div><span>@ViewCopy.Eyebrow</span><h1>@ViewCopy.Title</h1><p>@ViewCopy.Description</p></div>
                    <div class="system-status"><span><i></i>Wszystko pod kontrolą</span><strong>@PolishDate</strong></div>
                </header>

                @switch (_view)
                {
                    case "Dzisiaj":
                        @DashboardView()
                        break;
                    case "Zadania":
                        @TasksView()
                        break;
                    case "Kalendarz":
                        @CalendarView()
                        break;
                    case "Projekty i cele":
                        @ProjectsView()
                        break;
                    case "Przypomnienia":
                        @RemindersView()
                        break;
                    case "Notatki":
                        @NotesView()
                        break;
                    case "Arkusze i rejestry":
                        @SheetsView()
                        break;
                    case "Rutyny":
                        @RoutinesView()
                        break;
                    case "Obszary życia":
                        @AreasView()
                        break;
                    case "Formula":
                        @FormulaView()
                        break;
                }
            }
        </main>
    </section>

    <nav class="mobile-nav" aria-label="Nawigacja mobilna">
        @foreach (var item in MobileNavigation)
        {
            <button type="button" class="@NavClass(item.Name)" @onclick="() => SetView(item.Name)"><span>@Icon(item.Icon)</span>@item.MobileName</button>
        }
    </nav>
</div>

@code {
    private DashboardSnapshot? Dashboard;
    private string _view = "Dzisiaj";
    private string _newTask = string.Empty;
    private string _newNote = string.Empty;
    private string _search = string.Empty;
    private string _formulaChapter = "Dieta";
    private double _referenceLoadKg = 100;
    private AreaKey _selectedArea = AreaKey.Business;
    private int _duration = 30;
    private bool _menuCollapsed;
    private bool _mobileMenuOpen;
    private bool _quickMenuOpen;

    private static readonly NavGroup[] NavigationGroups =
    [
        new("NA CO DZIEŃ", [new("Dzisiaj", "home", "Dzisiaj"), new("Zadania", "tasks", "Zadania"), new("Kalendarz", "calendar", "Kalendarz")]),
        new("ZAPISZ I PAMIĘTAJ", [new("Notatki", "notes", "Notatki"), new("Przypomnienia", "bell", "Alerty")]),
        new("ROZWÓJ I DANE", [new("Projekty i cele", "target", "Projekty"), new("Rutyny", "repeat", "Rutyny"), new("Arkusze i rejestry", "table", "Rejestry"), new("Obszary życia", "areas", "Obszary")]),
        new("WIEDZA", [new("Formula", "formula", "Formula")])
    ];

    private static IEnumerable<NavItem> Navigation => NavigationGroups.SelectMany(group => group.Items);
    private static IEnumerable<NavItem> MobileNavigation => Navigation.Where(item => item.Name is "Dzisiaj" or "Zadania" or "Kalendarz" or "Notatki" or "Przypomnienia");

    private static readonly Dictionary<string, ViewHeading> Headings = new()
    {
        ["Dzisiaj"] = new("TWÓJ DZIEŃ", "Dzień dobry, Radek", "Zacznij od jednej ważnej rzeczy. Resztę masz tutaj pod kontrolą."),
        ["Zadania"] = new("DO ZROBIENIA", "Zadania", "Zapisuj konkretne kroki i spokojnie przechodź przez nie po kolei."),
        ["Kalendarz"] = new("TWÓJ CZAS", "Kalendarz", "Wszystkie zobowiązania i plany tygodnia w jednym miejscu."),
        ["Projekty i cele"] = new("DOKĄD ZMIERZASZ", "Projekty i cele", "Zobacz, jak codzienne działania przybliżają Cię do większych wyników."),
        ["Przypomnienia"] = new("NIE ZAPOMNIJ", "Przypomnienia", "LifeOS przypilnuje spraw, których nie chcesz trzymać w głowie."),
        ["Notatki"] = new("TWOJE MYŚLI", "Notatki", "Zapisuj pomysły, decyzje i materiały, zanim zdążą uciec."),
        ["Arkusze i rejestry"] = new("TWOJE DANE", "Arkusze i rejestry", "Finanse, kontakty, nauka i własne zestawienia w czytelnej formie."),
        ["Rutyny"] = new("DOBRE NAWYKI", "Rutyny", "Małe powtarzalne działania, które porządkują dzień i oszczędzają energię."),
        ["Obszary życia"] = new("SZERSZY OBRAZ", "Obszary życia", "Sprawdź, które części życia mają się dobrze, a które potrzebują uwagi."),
        ["Formula"] = new("BIBLIOTEKA SYSTEMU", "Formula", "Nauka o tym, jak ciało i umysł zamieniają codzienne decyzje w wynik.")
    };

    private ViewHeading ViewCopy => Headings[_view];
    private string PolishDate => DateTime.Today.ToString("dddd, d MMMM", CultureInfo.GetCultureInfo("pl-PL"));
    private IReadOnlyList<SearchResult> SearchResults => BuildSearchResults();
    private int ReminderCount => Dashboard?.OpenTasks ?? 0;
    private string ShellClass => _menuCollapsed ? "app-shell menu-collapsed" : "app-shell";
    private string SidebarClass => $"sidebar{(_menuCollapsed ? " collapsed" : string.Empty)}{(_mobileMenuOpen ? " mobile-open" : string.Empty)}";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync() => Dashboard = await Workspace.GetDashboardAsync();

    private void SetView(string view)
    {
        _view = view;
        _search = string.Empty;
        _quickMenuOpen = false;
        _mobileMenuOpen = false;
    }

    private void ToggleMenu() => _menuCollapsed = !_menuCollapsed;
    private void ToggleQuickMenu() => _quickMenuOpen = !_quickMenuOpen;
    private void OpenMobileMenu()
    {
        _menuCollapsed = false;
        _mobileMenuOpen = true;
    }
    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
        _quickMenuOpen = false;
    }

    private void OpenComposer(string view)
    {
        SetView(view);
        if (view == "Notatki") _newNote = string.Empty;
    }

    private string NavClass(string name) => _view == name ? "active" : string.Empty;
    private void ClearSearch() => _search = string.Empty;
    private void SearchChanged(ChangeEventArgs args) => _search = args.Value?.ToString() ?? string.Empty;

    private async Task AddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTask)) return;
        await Workspace.AddTaskAsync(_newTask, _selectedArea, _duration);
        _newTask = string.Empty;
        await ReloadAsync();
    }

    private async Task ToggleTaskAsync(Guid id)
    {
        await Workspace.ToggleTaskAsync(id);
        await ReloadAsync();
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_newNote)) return;
        await Workspace.AddNoteAsync(_newNote);
        _newNote = string.Empty;
        await ReloadAsync();
    }

    private async Task ToggleRoutineAsync(Guid id)
    {
        await Workspace.ToggleRoutineAsync(id);
        await ReloadAsync();
    }

    private IReadOnlyList<SearchResult> BuildSearchResults()
    {
        if (Dashboard is null || string.IsNullOrWhiteSpace(_search)) return [];
        return Dashboard.Tasks
            .Where(task => task.Title.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
            .Select(task => new SearchResult("Zadanie", task.Title))
            .Concat(Dashboard.Notes
                .Where(note => note.Content.Contains(_search, StringComparison.CurrentCultureIgnoreCase))
                .Select(note => new SearchResult("Notatka", note.Content)))
            .Take(10)
            .ToArray();
    }

    private RenderFragment DashboardView() => @<div class="home-command">
        <section class="home-zone">
            <header class="zone-heading"><span><i></i>01 / TERAZ</span><p>Jedna rzecz, która ma dziś pierwszeństwo.</p></header>
            <article class="focus-card">
                @if (Dashboard!.Tasks.FirstOrDefault(task => !task.IsCompleted) is { } focusTask)
                {
                    <div class="focus-card-copy">
                        <span>NAJWAŻNIEJSZE TERAZ</span>
                        <h2>@focusTask.Title</h2>
                        <p><i style="background: @Area(focusTask.Area).Color"></i>@Area(focusTask.Area).Name <b>·</b> około @focusTask.DurationMinutes min</p>
                    </div>
                    <div class="focus-progress"><strong>@Dashboard.TaskProgress%</strong><span>planu gotowe</span></div>
                    <div class="focus-progress-bar"><i style="width: @(Dashboard.TaskProgress)%"></i></div>
                    <footer>
                        <button class="focus-done" type="button" @onclick="() => ToggleTaskAsync(focusTask.Id)">✓ Oznacz jako zrobione</button>
                        <button class="focus-plan" type="button" @onclick='() => SetView("Zadania")'>Zobacz cały plan →</button>
                    </footer>
                }
                else
                {
                    <div class="focus-empty"><span>✓</span><div><h2>Plan na dziś jest gotowy</h2><p>Możesz odpocząć albo zaplanować kolejny krok.</p></div></div>
                    <footer><button class="focus-done" type="button" @onclick='() => OpenComposer("Zadania")'>+ Dodaj zadanie</button></footer>
                }
            </article>
        </section>

        <section class="home-zone next-zone">
            <header class="zone-heading"><span><i></i>02 / PÓŹNIEJ</span><p>Tylko trzy następne kroki. Pełny system pozostaje w swoich modułach.</p></header>
            <article class="panel next-actions">
                <header><div><span>KOLEJKA</span><h2>Następne działania</h2></div><button type="button" @onclick='() => SetView("Zadania")'>Otwórz plan →</button></header>
                <div class="task-list">
                    @foreach (var task in Dashboard.Tasks.Where(task => !task.IsCompleted).Skip(1).Take(3))
                    {
                        @TaskRow(task)
                    }
                    @if (Dashboard.Tasks.Count(task => !task.IsCompleted) <= 1)
                    {
                        <div class="quiet-empty"><span>02</span><p><strong>Kolejka jest czysta.</strong> Dodaj następny krok dopiero, gdy naprawdę go potrzebujesz.</p></div>
                    }
                </div>
            </article>
        </section>
    </div>;

    private RenderFragment TasksView() => @<section class="panel manager-panel">
        <header><div><span>POSTĘP DNIA</span><h2>@Dashboard!.TaskProgress% zrealizowane</h2></div><b>@Dashboard.OpenTasks otwarte</b></header>
        @TaskComposer()
        <div class="task-list large">@foreach (var task in Dashboard.Tasks) { @TaskRow(task) }</div>
    </section>;

    private RenderFragment CalendarView() => @<text>
        <div class="view-toolbar"><div class="segmented"><button class="active" type="button">Tydzień</button><button type="button">Miesiąc</button></div><button class="secondary-button" type="button" @onclick='() => OpenComposer("Zadania")'>+ Zaplanuj zadanie</button></div>
        <section class="week-board">
        @foreach (var day in WeekDays)
        {
            var isToday = day.Date == DateTime.Today;
            <article class="@(isToday ? "today" : "")"><header><div><span>@day.ToString("ddd", CultureInfo.GetCultureInfo("pl-PL"))</span><strong>@day.Day</strong></div><b>@(isToday ? Dashboard!.Tasks.Count : 0)</b></header>@if (isToday) { @foreach (var task in Dashboard!.Tasks) { <button type="button" class="@(task.IsCompleted ? "done" : "")" @onclick="() => ToggleTaskAsync(task.Id)"><i style="background: @Area(task.Area).Color"></i>@task.Title</button> } } else { <button type="button" class="empty-day">+ Dodaj priorytet</button> }</article>
        }
        </section>
    </text>;

    private RenderFragment ProjectsView() => @<section class="project-grid">
        @foreach (var area in Dashboard!.Areas)
        {
            var areaTasks = Dashboard.Tasks.Where(task => task.Area == area.Key).ToArray();
            var completed = areaTasks.Count(task => task.IsCompleted);
            var progress = areaTasks.Length == 0 ? 0 : completed * 100 / areaTasks.Length;
            <article style="--area-color: @area.Color">
                <header><span><i></i>@area.Name</span><b>@progress%</b></header>
                <h2>@area.Objective</h2>
                <em><i style="width: @(progress)%"></i></em>
                <div><span>@areaTasks.Length działań</span><span>@completed zakończonych</span></div>
                <button type="button" @onclick="() => SelectAreaTasks(area.Key)">Otwórz działania <span>→</span></button>
            </article>
        }
        <button class="new-project-card" type="button"><span>+</span><strong>Nowy projekt lub cel</strong><small>Połącz wynik z zadaniami, notatkami i terminami</small></button>
    </section>;

    private RenderFragment RemindersView() => @<section class="reminders-layout">
        <article class="panel reminder-list">
            <header><div><span>DO PILNOWANIA</span><h2>Najbliższe przypomnienia</h2></div><b>@ReminderCount aktywnych</b></header>
            <div>
                @foreach (var task in Dashboard!.Tasks.Where(task => !task.IsCompleted))
                {
                    <button type="button" @onclick="() => ToggleTaskAsync(task.Id)"><span class="reminder-time"><strong>Dzisiaj</strong><small>@(DateTime.Today.AddHours(18).ToString("HH:mm"))</small></span><i style="background: @Area(task.Area).Color"></i><p><strong>@task.Title</strong><small>@Area(task.Area).Name · zadanie</small></p><em>Oznacz gotowe</em></button>
                }
            </div>
        </article>
        <aside class="reminder-summary">
            <article><span>@Icon("bell")</span><div><small>AKTYWNE</small><strong>@ReminderCount</strong><p>Spraw wymagających uwagi</p></div></article>
            <article><span>@Icon("repeat")</span><div><small>CYKLICZNE</small><strong>@Dashboard!.Routines.Count</strong><p>Rutyny przypominane każdego dnia</p></div></article>
            <button type="button" @onclick='() => OpenComposer("Zadania")'>+ Dodaj sprawę do przypomnienia</button>
        </aside>
    </section>;

    private RenderFragment NotesView() => @<section class="notes-view">
        @NoteComposer(true)
        <div class="note-grid">@if (Dashboard!.Notes.Count == 0) { <div class="empty-state"><strong>Inbox jest pusty</strong><p>Pierwsza notatka pojawi się tutaj.</p></div> } else { @foreach (var note in Dashboard.Notes) { <article><span>@note.CreatedAt.ToLocalTime().ToString("d MMM, HH:mm", CultureInfo.GetCultureInfo("pl-PL"))</span><p>@note.Content</p></article> } }</div>
    </section>;

    private RenderFragment SheetsView() => @<text>
        <section class="register-grid">
            <button type="button"><span class="register-icon blue">@Icon("wallet")</span><div><strong>Budżet miesięczny</strong><small>Przychody, koszty i cele finansowe</small></div><em>W przygotowaniu</em></button>
            <button type="button"><span class="register-icon orange">@Icon("contacts")</span><div><strong>Kontakty i CRM</strong><small>Relacje, klienci i kolejne kroki</small></div><em>W przygotowaniu</em></button>
            <button type="button" @onclick='() => SetView("Rutyny")'><span class="register-icon green">@Icon("repeat")</span><div><strong>Monitor rutyn</strong><small>Regularność i realizacja systemu dnia</small></div><em>@Dashboard!.CompletedRoutines/@Dashboard.Routines.Count dziś</em></button>
            <button type="button"><span class="register-icon violet">@Icon("learning")</span><div><strong>Rozwój i nauka</strong><small>Materiały, sesje i postępy kompetencji</small></div><em>W przygotowaniu</em></button>
        </section>
        <section class="panel data-table-panel">
            <header><div><span>WSPÓLNA BAZA</span><h2>Rejestr aktywności</h2></div><button type="button">Eksportuj CSV</button></header>
            <div class="data-table">
                <div class="data-row data-head"><span>Element</span><span>Obszar</span><span>Typ</span><span>Status</span><span>Czas</span></div>
                @foreach (var task in Dashboard!.Tasks)
                {
                    <button class="data-row" type="button" @onclick="() => ToggleTaskAsync(task.Id)"><strong>@task.Title</strong><span><i style="background:@Area(task.Area).Color"></i>@Area(task.Area).Name</span><span>Zadanie</span><span class="@(task.IsCompleted ? "status-done" : "status-open")">@(task.IsCompleted ? "Gotowe" : "Otwarte")</span><span>@task.DurationMinutes min</span></button>
                }
            </div>
        </section>
    </text>;

    private RenderFragment RoutinesView() => @<section class="routines-workspace">
        <article class="routine-score"><span>@Icon("repeat")</span><div><small>REALIZACJA DZISIAJ</small><strong>@Dashboard!.CompletedRoutines <i>/ @Dashboard.Routines.Count</i></strong><p>Każde odhaczenie aktualizuje centrum oraz rejestry.</p></div></article>
        <div class="routine-cards">
            @foreach (var routine in Dashboard!.Routines)
            {
                <button type="button" class="@(routine.IsCompletedToday ? "done" : "")" @onclick="() => ToggleRoutineAsync(routine.Id)"><i>@(routine.IsCompletedToday ? "✓" : "")</i><div><small>@routine.Schedule</small><strong>@routine.Name</strong><span>@(routine.IsCompletedToday ? "Zrealizowano dzisiaj" : "Oczekuje na realizację")</span></div><em>→</em></button>
            }
            <button class="add-routine" type="button"><i>+</i><div><strong>Dodaj nową rutynę</strong><span>Zbuduj powtarzalny element swojego systemu</span></div></button>
        </div>
    </section>;

    private RenderFragment AreasView() => @<section class="area-grid">
        @foreach (var area in Dashboard!.Areas)
        {
            <button type="button" class="@(area.Key == _selectedArea ? "active" : "")" style="--area-color: @area.Color" @onclick="() => _selectedArea = area.Key"><header><span><i></i>@area.Name</span><strong>@area.Score<small>/100</small></strong></header><em><b style="width: @(area.Score)%"></b></em><p>@area.Objective</p><footer>Ustaw jako priorytet <span>→</span></footer></button>
        }
    </section>;

    private RenderFragment FormulaView() => @<section class="formula-layout">
        <aside class="formula-library">
            <div class="formula-library-title"><span>FORMULA / INDEX</span><strong>Rozdziały</strong></div>
            <button class="@(_formulaChapter == "Dieta" ? "active" : "")" type="button" @onclick='() => _formulaChapter = "Dieta"'><span>01</span><div><strong>Dieta</strong><small>Odżywianie i adaptacja</small></div><em>12 min</em></button>
            <button class="@(_formulaChapter == "Sen" ? "active" : "")" type="button" @onclick='() => _formulaChapter = "Sen"'><span>02</span><div><strong>Sen</strong><small>Regeneracja i pamięć</small></div><em>16 min</em></button>
            <div class="formula-principle"><span>ZASADA FORMULA</span><p>Najpierw zrozum mechanizm. Potem zaprojektuj system, który działa również w słabszy dzień.</p></div>
        </aside>

        @if (_formulaChapter == "Dieta")
        {
            <article class="formula-article">
            <header class="formula-hero">
                <div class="formula-code"><span>FORMULA</span><i></i><span>01</span></div>
                <p class="formula-kicker">FUNDAMENTY WYDAJNOŚCI</p>
                <h2>Dieta</h2>
                <p class="formula-lead">Trening daje organizmowi sygnał do zmiany. Dieta dostarcza energii, budulca i warunków, dzięki którym ten sygnał może zostać zamieniony w adaptację.</p>
                <div class="formula-meta"><span>Poziom: fundament</span><span>Czas: 12 min</span><span>Aktualizacja: 2026</span></div>
            </header>

            <div class="formula-reading">
                <nav class="article-toc" aria-label="Spis treści artykułu">
                    <span>W TYM ROZDZIALE</span>
                    <a href="#formula-experiment">01. Ten sam trening, dwa wyniki</a>
                    <a href="#formula-energy">02. Energia i makroskładniki</a>
                    <a href="#formula-quality">03. Jakość i stan zapalny</a>
                    <a href="#formula-practice">04. Przełożenie na praktykę</a>
                </nav>

                <div class="article-body">
                    <section class="article-intro">
                        <p>Wyobraź sobie dwie osoby wykonujące ten sam plan. Obie trenują ciężko, śpią podobną liczbę godzin i mają zbliżone predyspozycje. Pierwsza je przypadkowo: raz za mało, raz bardzo dużo, większość kalorii czerpie z produktów wysokoprzetworzonych. Druga pokrywa zapotrzebowanie energetyczne, rozkłada białko w ciągu dnia, dopasowuje węglowodany do wysiłku i regularnie je warzywa, owoce, pełne ziarna, strączki oraz wartościowe tłuszcze.</p>
                        <p>Na pojedynczym treningu różnica może być ledwie widoczna. Po kilku miesiącach kumuluje się jednak w jakości kolejnych sesji, szybkości odbudowy zapasów, utrzymaniu masy mięśniowej, odporności i ryzyku przerw w treningu.</p>
                    </section>

                    <section id="formula-experiment" class="article-section">
                        <span class="section-number">01 / MODEL</span>
                        <h3>Ten sam bodziec nie gwarantuje tego samego wyniku</h3>
                        <p>Mięśnie nie rosną w trakcie serii. Trening chwilowo zaburza równowagę organizmu: zużywa glikogen, zwiększa obrót białek i wywołuje kontrolowaną odpowiedź zapalną. Adaptacja zachodzi później — jeśli ciało ma z czego odbudować uszkodzone struktury i przywrócić gotowość do kolejnego wysiłku.</p>

                        <div class="athlete-comparison">
                            <article class="athlete-case weak">
                                <header><span>A</span><div><strong>Ciężki trening + przypadkowa dieta</strong><small>Bodziec bez stabilnego zaplecza</small></div></header>
                                <ul>
                                    <li>Nierówna podaż energii i częstsze „puste” treningi</li>
                                    <li>Białko zebrane głównie w jednym posiłku</li>
                                    <li>Mało błonnika, potasu, magnezu i związków roślinnych</li>
                                    <li>Większa zmienność energii, sytości i jakości regeneracji</li>
                                </ul>
                            </article>
                            <article class="athlete-case strong">
                                <header><span>B</span><div><strong>Ciężki trening + odżywczy system</strong><small>Bodziec wsparty materiałem do adaptacji</small></div></header>
                                <ul>
                                    <li>Energia dopasowana do obciążenia i celu</li>
                                    <li>Pełnowartościowe białko rozłożone w ciągu dnia</li>
                                    <li>Węglowodany dostępne wtedy, gdy wymaga ich wysiłek</li>
                                    <li>Codzienna różnorodność roślin i wartościowych tłuszczów</li>
                                </ul>
                            </article>
                        </div>

                        <div class="formula-equation"><span>ADAPTACJA</span><strong>trening × energia × budulec × regeneracja</strong><p>Jeśli jeden z mnożników przez długi czas pozostaje bliski zeru, większa ilość treningu nie naprawia całego równania.</p></div>
                    </section>

                    <section id="formula-energy" class="article-section">
                        <span class="section-number">02 / PALIWO I BUDULEC</span>
                        <h3>Białko, tłuszcze i węglowodany mają różne zadania</h3>
                        <p>„Idealny rozkład B/T/W” nie jest jedną stałą proporcją dla wszystkich. Zależy od masy ciała, rodzaju sportu, objętości treningu i celu. Liczy się hierarchia: najpierw odpowiednia energia, następnie wystarczająca ilość makroskładników, a dopiero później precyzyjny timing.</p>

                        <div class="macro-grid">
                            <article><span class="macro-symbol protein">B</span><div><strong>Białko</strong><p>Dostarcza aminokwasów do przebudowy mięśni, enzymów i wielu struktur organizmu. Dla większości osób regularnie trenujących literatura sportowa wskazuje około <b>1,4–2,0 g/kg masy ciała na dobę</b>; potrzeby mogą być wyższe w deficycie energii.</p></div></article>
                            <article><span class="macro-symbol carbs">W</span><div><strong>Węglowodany</strong><p>Są głównym źródłem szybko dostępnej energii podczas wysiłku o wyższej intensywności. Ich ilość warto zmieniać wraz z obciążeniem: więcej przy ciężkich i długich sesjach, mniej w lekkie dni — bez automatycznego demonizowania tej grupy.</p></div></article>
                            <article><span class="macro-symbol fats">T</span><div><strong>Tłuszcze</strong><p>Wspierają błony komórkowe, produkcję hormonów i wchłanianie witamin A, D, E i K. Ważna jest jakość: oliwa, orzechy, pestki, awokado i ryby powinny częściej zastępować tłuszcze trans oraz nadmiar tłuszczów nasyconych.</p></div></article>
                        </div>

                        <aside class="science-note"><span>WAŻNIEJSZE NIŻ „CZYSTA MICHA”</span><p>Zbyt niska dostępność energii może uderzać w hormony, kości, odporność, samopoczucie i wydolność — także u mężczyzn. Organizm nie interpretuje niedojadania jako dyscypliny; interpretuje je jako brak zasobów.</p></aside>
                    </section>

                    <section id="formula-quality" class="article-section">
                        <span class="section-number">03 / JAKOŚĆ ŚRODOWISKA</span>
                        <h3>„Antyzapalna” oznacza wzorzec, nie magiczny produkt</h3>
                        <p>Stan zapalny po treningu jest częścią adaptacji — nie należy próbować wyzerować go za wszelką cenę. Problemem jest raczej przewlekłe środowisko tworzone przez niedobór energii i mikroskładników, małą ilość snu, stres oraz dietę opartą głównie na produktach wysokoprzetworzonych.</p>
                        <p>Odżywczy wzorzec przypominający dietę śródziemnomorską dostarcza błonnika, nienasyconych kwasów tłuszczowych i wielu związków bioaktywnych. W praktyce oznacza dużą różnorodność warzyw i owoców, pełne ziarna, strączki, orzechy, nasiona, oliwę oraz regularne źródła omega‑3. To nie „detoks”, lecz codzienne kształtowanie środowiska metabolicznego.</p>

                        <div class="nutrient-band">
                            <div><strong>≥ 400 g</strong><span>warzyw i owoców dziennie</span></div>
                            <div><strong>≥ 25 g</strong><span>naturalnego błonnika dziennie</span></div>
                            <div><strong>różnorodność</strong><span>kolorów, źródeł i stopnia przetworzenia</span></div>
                        </div>

                        <blockquote><p>Warzywa i owoce nie są dodatkiem dekoracyjnym do makro. Pomagają domknąć pulę witamin, minerałów, błonnika i związków roślinnych potrzebnych do normalnego działania układu odpornościowego, nerwowego oraz pokarmowego.</p></blockquote>
                    </section>

                    <section id="formula-practice" class="article-section">
                        <span class="section-number">04 / SYSTEM</span>
                        <h3>Jak przełożyć teorię na zwykły dzień</h3>
                        <ol class="formula-protocol">
                            <li><span>01</span><div><strong>Pokryj energię</strong><p>Nie zaczynaj od suplementów, jeśli regularnie nie dojadasz względem treningu i regeneracji.</p></div></li>
                            <li><span>02</span><div><strong>Rozłóż białko</strong><p>Umieść pełnowartościowe źródło w 3–5 posiłkach, zamiast nadrabiać całość późnym wieczorem.</p></div></li>
                            <li><span>03</span><div><strong>Dopasuj węglowodany</strong><p>Największe porcje kieruj w okolice najbardziej wymagających jednostek treningowych.</p></div></li>
                            <li><span>04</span><div><strong>Buduj kolor i różnorodność</strong><p>Każdego dnia jedz kilka rodzajów warzyw i owoców oraz rotuj źródła białka, zbóż i tłuszczów.</p></div></li>
                            <li><span>05</span><div><strong>Oceniaj trend</strong><p>Patrz na energię, głód, sen, progres treningowy i częstotliwość infekcji w skali tygodni, nie pojedynczego posiłku.</p></div></li>
                        </ol>

                        <div class="article-conclusion"><span>WNIOSKI</span><h3>Dobra dieta nie zastępuje treningu. Sprawia, że trening ma z czego zadziałać.</h3><p>Perfekcja nie jest wymagana. Przewagę daje powtarzalny system, w którym większość posiłków dostarcza potrzebnej energii i składników, a mniej odżywcze jedzenie pozostaje świadomym dodatkiem — nie fundamentem.</p></div>
                    </section>

